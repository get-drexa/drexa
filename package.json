		"drexa": "bun run apps/cli/index.ts"
	},
	"devDependencies": {
		"@biomejs/biome": "2.2.4",
		"@types/bun": "latest",
		"convex": "^1.27.0"
	},
	"resolutions": {
		"convex": "1.28.0"
	},
	"dependencies": {
		"@tailwindcss/vite": "^4.1.14"
	}
}
